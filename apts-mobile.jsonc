// APTS-MB-5. ramps: expand; fixed: keep unchanged.
// One shared curve without profiles; neutral is a fixed source scale.
{
  "algorithm": {
    "version": "APTS-MB-5",
    "space": "encoded-sRGB",
    "steps": [
      50,
      100,
      200,
      300,
      400,
      500,
      600,
      700,
      800,
      900
    ],
    "denominator": 1000000,
    "weights": [
      48698,
      77660,
      156851,
      277217,
      617325,
      1000000,
      815154,
      675198,
      498326,
      319742
    ],
    "formula": "floor((T*(1000000-k)+B*k+500000)/1000000)",
    "neutral": "fixed source scale; no generation",
    "input": "one opaque #RRGGBB; the same weights apply to all color names"
  },
  "ramps": {
    "mb-secondary": {
      "base": "#965DF5",
