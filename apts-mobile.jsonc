// APTS-MB-4. ramps: expand; fixed: keep unchanged.
// Two profiles without corrections; neutral is a fixed source scale.
{
  "algorithm": {
    "version": "APTS-MB-4",
    "space": "encoded-sRGB",
    "steps": [
      50,
      100,
      200,
      300,
      400,
      500,
      600,
      700,
      800,
      900
    ],
    "denominator": 1000000,
    "formula": "floor((T*(1000000-k)+B*k+500000)/1000000)",
    "profiles": "brand and standard; no per-color corrections",
    "neutral": "fixed source scale; no generation",
    "sourceAccuracy": "brand: exact for the reference base; standard: max RGB delta 3 on the approved source shades"
  },
  "profiles": {
    "brand": {
      "name": "Брендовый",
